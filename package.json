{
  "name": "ghost-markdown",
  "displayName": "Ghost Markdown",
  "description": "A focused Markdown viewer and editor for VS Code.",
  "publisher": "MickyBalladelli",
  "author": {
    "name": "Micky Balladelli"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MickyBalladelli/Markdown.git"
  },
  "icon": "Ghost2.png",
  "license": "MIT",
  "version": "0.4.2",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:ghostMarkdown.open"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ghostMarkdown.open",
        "title": "Open Markdown with Ghost Markdown"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "bump-version": "bash scripts/bump-version.sh",
    "build-install-vsix": "bash scripts/build-install-vsix.sh",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "markdown-it": "^14.3.2"
  }
}
